{
  "name": "@travelonium/videojs-ab-loop",
  "version": "1.0.0",
  "description": "A\u2013B range looping on the Video.js progress bar, with touch, keyboard and full-video repeat controls.",
  "type": "module",
  "main": "dist/videojs-ab-loop.cjs",
  "module": "dist/videojs-ab-loop.es.js",
  "browser": "dist/videojs-ab-loop.js",
  "style": "dist/videojs-ab-loop.css",
  "exports": {
    ".": {
      "import": "./dist/videojs-ab-loop.es.js",
      "require": "./dist/videojs-ab-loop.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "lint": "eslint src test scripts examples *.js",
    "dev": "vite --host 127.0.0.1 --open /examples/",
    "check": "npm run lint && npm test && npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "video.js": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "rollup": "^4.34.0",
    "sass": "^1.83.0",
    "video.js": "8.21.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/travelonium/videojs-ab-loop.git"
  },
  "homepage": "https://github.com/travelonium/videojs-ab-loop#readme",
  "bugs": {
    "url": "https://github.com/travelonium/videojs-ab-loop/issues"
  },
  "author": "Travelonium",
  "license": "MIT",
  "keywords": [
    "videojs",
    "videojs-plugin",
    "video",
    "ab-loop",
    "loop",
    "repeat"
  ],
  "publishConfig": {
    "access": "public"
  }
}
